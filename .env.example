# Copy to .env and adjust. `apps/api/src/env.ts` validates these with Zod at boot and
# refuses to start if any are missing or malformed. See docs/09-deployment.md.

# ---- database (used by the db container AND composed into DATABASE_URL) ----
POSTGRES_USER=cedo
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=cedo

# ---- api ----
# Inside compose the host is the service name `db`. For local dev against `bun run db:up`,
# use localhost.
DATABASE_URL=postgres://cedo:change-me-before-deploying@db:5432/cedo
PORT=3000
NODE_ENV=production

# Where uploaded media bytes are written. Mounted as a docker volume in production.
# Where uploaded media bytes are written. Mounted as a docker volume in production; for local
# development point it anywhere disposable. Tests IGNORE this and use a temp directory per worker.
UPLOAD_DIR=/data/uploads

# ---- web ----
# Host port for the web container. The app always calls the RELATIVE path /api, which Caddy
# proxies to the api service, so no API URL is ever baked into the build.
WEB_PORT=8080

# ---- tests only ----
# Throwaway database, started by `bun run db:test` (docker-compose.test.yml, port 55433).
#
# NEVER point this at a real database. The test harness TRUNCATES EVERY TABLE. When NODE_ENV=test
# — which `bun test` sets automatically — DATABASE_URL is ignored entirely and this is used
# instead, so a stray test run cannot reach development or production data.
#
# Under `bun test --parallel` each worker appends its id (cedo_test_w1, cedo_test_w2, ...).
TEST_DATABASE_URL=postgres://cedo:cedo@localhost:55433/cedo_test

# Host port for the database, local development only.
POSTGRES_PORT=55432
