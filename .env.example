# Copy to .env — `bun run setup` does it for you.
#
# THE DEFAULTS BELOW ARE FOR LOCAL DEVELOPMENT and work as they are. You only need to edit anything
# if you are deploying, and the one thing you must change then is POSTGRES_PASSWORD.
#
# `apps/api/src/env.ts` validates all of this with Zod at boot and refuses to start if something is
# missing or malformed, so a typo here is a readable message rather than a crash later.

# ---- the database container -------------------------------------------------------------------
# Used by docker compose to create the Postgres cluster.
POSTGRES_USER=cedo
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=cedo

# Where the dev database is published on your machine. Bound to LOOPBACK: the API and web
# containers reach Postgres over the compose network and never need this mapping. Set
# POSTGRES_BIND=0.0.0.0 only if you deliberately want it reachable from another machine.
POSTGRES_PORT=55432
POSTGRES_BIND=127.0.0.1

# ---- the API, when YOU run it -------------------------------------------------------------------
# These are read by `bun run dev` / `bun run dev:api` on your machine.
#
# `docker compose` does NOT read DATABASE_URL from here — it composes its own with the hostname
# `db`, which only resolves inside the compose network. That is why this one says localhost: it
# exists for the API you run yourself, and pointing it at `db` fails with ENOTFOUND.
DATABASE_URL=postgres://cedo:devpassword@localhost:55432/cedo
PORT=3000
NODE_ENV=development

# Where uploaded media bytes are written. A relative path for development; in production this is a
# docker volume at /data/uploads. Tests ignore it and use a temp directory.
UPLOAD_DIR=.artifacts/uploads

# The username promoted to curator of the shared `cedo` exercise library on every seed run. A
# curator can edit the shared library and read instance diagnostics; everyone else reads the library
# and manages only their own things. Register the account FIRST, then restart. Leave blank for a
# personal instance whose library never changes.
CEDO_CURATOR_USERNAME=

# ---- the web container ---------------------------------------------------------------------------
# Host port for the deployed app. The browser always calls the relative path /api, which Caddy
# proxies to the API, so no API URL is ever baked into the build.
WEB_PORT=8080
# Every interface, so the app is reachable on your network. 127.0.0.1 when a reverse proxy on the
# same host serves it over HTTPS — the only way it installs to a phone (docs/09-deployment.md).
WEB_BIND=0.0.0.0

# ---- tests ----------------------------------------------------------------------------------------
# The throwaway database, started by `bun run db:up` (docker-compose.test.yml, port 55433).
#
# NEVER point this at a real database. The test harness TRUNCATES EVERY TABLE. Whenever
# NODE_ENV=test — which `bun test` sets on its own — DATABASE_URL is ignored entirely and this is
# used instead, so a stray test run cannot reach your development data.
#
# Under `bun test --parallel` each worker appends its id (cedo_test_w1, cedo_test_w2, …), and
# `bun run perf` appends _perf.
TEST_DATABASE_URL=postgres://cedo:cedo@localhost:55433/cedo_test
