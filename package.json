{
  "name": "cedo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:server": "oxlint -c .oxlintrc.typeaware.json --deny-warnings packages/contract apps/api scripts test",
    "lint:app": "oxlint --deny-warnings apps/app",
    "lint": "bun run lint:server && bun run lint:app",
    "typecheck:server": "tsc -b . && tsc -p apps/api/tsconfig.tools.json",
    "typecheck:app": "apps/app/node_modules/.bin/tsc -p apps/app --noEmit",
    "typecheck": "bun run typecheck:server && bun run typecheck:app",
    "test": "bun test --parallel",
    "test:changed": "bun test --changed",
    "e2e": "bun run build:app && bun test ./apps/app/e2e/*.e2e.ts",
    "shot": "bun run build:app && bun run apps/app/e2e/shot.ts",
    "perf": "CEDO_PERF=1 bun test ./apps/api/src/test/perf/*.perf.ts",
    "check": "bun run format && bun run lint && bun run typecheck && bun run docs:links && bun run test",
    "db:up": "docker compose up -d --wait db",
    "db:test": "docker compose -f docker-compose.test.yml up -d --wait",
    "docs:links": "bun run scripts/check-doc-links.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && bun run apps/api/src/db/migrate.ts && bun run apps/api/src/db/seed.ts",
    "check:ci": "bun run format:check && bun run lint && bun run typecheck && bun run docs:links && bun run test",
    "perf:seed": "CEDO_PERF=1 NODE_ENV=test bun run apps/api/src/db/seed-perf/index.ts",
    "perf:report": "CEDO_PERF=1 NODE_ENV=test bun run apps/api/src/test/perf/report.ts",
    "build:app": "cd apps/app && ./node_modules/.bin/expo export --platform web --output-dir dist",
    "e2e:only": "bun test ./apps/app/e2e/*.e2e.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
