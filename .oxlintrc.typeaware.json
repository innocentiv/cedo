{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/return-await": ["error", "always"],
    "typescript/prefer-readonly-parameter-types": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/db/schema.ts", "**/db/schema", "**/db/tables/*"],
            "importNames": [
              "exercises",
              "exerciseMuscles",
              "exerciseMedia",
              "workouts",
              "workoutDays",
              "workoutEntries",
              "workoutSets"
            ],
            "allowTypeImports": true,
            "message": "Read owned tables through db/visible.ts (visibleExercises(caller), …). Writes belong in the module's write*.ts. See docs/adr/0019-visible-relations.md."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    ".expo",
    ".artifacts",
    ".tsbuild",
    "apps/api/drizzle",
    "**/*.d.ts",
    "apps/api/drizzle.config.ts"
  ],
  "overrides": [
    {
      "files": ["**/seed-data/**", "**/test/perf/hot-paths.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": [
        "apps/api/src/db/**",
        "apps/api/src/modules/*/write*.ts",
        "apps/api/src/test/**",
        "**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
