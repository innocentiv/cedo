# The single published surface. Everything the browser sees is one origin, so there is no CORS
# configuration anywhere in this project and no preflight on any mutation.
# See docs/09-deployment.md.

# A proxy on a private network in front of Caddy — a host's nginx, a NAS's reverse proxy — is
# trusted to say who its client was, so `X-Forwarded-For` reaches the API with the real address, and
# the login limit counts per client rather than per proxy (#72, ADR-0031). Anything else that writes
# the header is overwritten with the address Caddy saw. apps/api/src/lib/client-address.ts reads the
# result with the same private ranges.
{
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip
	root * /srv

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	# Build output — the bundle under /_expo/static and the exported images and fonts under /assets
	# — is content-hashed: served as files, or a real 404, never the SPA fallback. Answering a stale
	# hash with index.html is a 200 of HTML where a script or an image was expected, which the
	# browser fails on obscurely instead of visibly.
	@build path /_expo/static/* /assets/*
	handle @build {
		file_server
	}

	handle {
		# The web build is `output: "single"` — one index.html — so a real file is tried first and
		# everything else is the app. See apps/app/app.json and docs/08-frontend.md.
		try_files {path} /index.html
		file_server
	}

	# Build output is content-hashed, so it can be cached forever — but only an actual answer: a 404
	# marked immutable would be cached as THE answer for that URL. 304 is included because a
	# revalidation must repeat the freshness the 200 carried (RFC 9110 §15.4.5).
	header @build {
		Cache-Control "public, max-age=31536000, immutable"
		match {
			status 2xx 304
		}
	}

	# The app's documents must never be cached. Matched on what is NOT build output (and NOT the
	# API), rather than on `*.html`: Caddy evaluates `header` before `handle`, so a matcher sees the
	# request path BEFORE try_files rewrites it — and `/today` does not end in `.html`. Only `/` was
	# getting the no-cache header, so a browser holding a stale `/today` asked for a bundle the new
	# image no longer contained, and the app failed to boot on exactly the route it was left on.
	#
	# `/api/*` is excluded because the API sets its own caching: a second, earlier
	# `Cache-Control: no-cache` here overrode the immutable header on media blobs (ADR 0009), and
	# every image was downloaded again on every render.
	@document not path /_expo/static/* /assets/* /api/*
	header @document Cache-Control "no-cache"

	log {
		output stderr
		format console
	}
}
