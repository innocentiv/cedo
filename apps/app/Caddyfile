# The single published surface. Everything the browser sees is one origin, so there is no CORS
# configuration anywhere in this project and no preflight on any mutation.
# See docs/09-deployment.md.
:80 {
	encode zstd gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# The web build is `output: "single"` — one index.html — so a real asset is tried first and
		# everything else is the app. See apps/app/app.json and docs/08-frontend.md.
		try_files {path} /index.html
		file_server
	}

	# The bundle is content-hashed, so it can be cached forever; everything else must not be.
	#
	# Matched on what is NOT the bundle, rather than on `*.html`. Caddy evaluates `header` before
	# `handle`, so a matcher sees the request path BEFORE try_files rewrites it — and `/today` does
	# not end in `.html`. Only `/` was getting the no-cache header, so a browser holding a stale
	# `/today.html` asked for a content-hashed bundle that the new image no longer contains, and the
	# app failed to boot on exactly the route the user had left it on.
	@immutable path /_expo/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@document not path /_expo/static/*
	header @document Cache-Control "no-cache"

	log {
		output stderr
		format console
	}
}
