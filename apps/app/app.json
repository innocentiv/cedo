{
  "expo": {
    "name": "cedo",
    "slug": "cedo",
    "version": "0.0.0",
    "scheme": "cedo",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
