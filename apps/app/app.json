{
  "expo": {
    "name": "cedo",
    "slug": "cedo",
    "version": "0.1.1",
    "scheme": "cedo",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": false } }],
      "@bacons/apple-targets",
      ["expo-secure-store", { "faceIDPermission": false }],
      [
        "expo-image-picker",
        {
          "photosPermission": "cedo uses your photos to attach an image to an exercise.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "sounds": ["./assets/chime.wav", "./assets/rest-alarm.wav"]
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.innocentiv.cedo",
      "buildNumber": "2",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "cedo connects to your server when it is on your local network.",
        "NSAlarmKitUsageDescription": "cedo rings an alarm when a rest is over, if you choose it in Settings.",
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "io.github.innocentiv.cedo"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
