{
  "expo": {
    "name": "cedo",
    "slug": "cedo",
    "version": "0.0.0",
    "scheme": "cedo",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": false } }],
      ["expo-secure-store", { "faceIDPermission": false }],
      [
        "expo-image-picker",
        {
          "photosPermission": "cedo uses your photos to attach an image to an exercise.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.innocentiv.cedo",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "cedo connects to your server when it is on your local network."
      }
    },
    "android": {
      "package": "io.github.innocentiv.cedo"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
