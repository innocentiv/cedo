{
  "expo": {
    "name": "cedo",
    "slug": "cedo",
    "version": "0.0.0",
    "scheme": "cedo",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [["expo-router", { "asyncRoutes": { "web": false } }], "expo-secure-store"],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
